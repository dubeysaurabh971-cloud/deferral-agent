LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
RESOLVER_MODEL=claude-sonnet-5

# Only used when LLM_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=grok-4-fast

# Only used when LLM_PROVIDER=gemini (Google AI Studio key, via the OpenAI-compat endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional: model for the LLM-judge scorers. Defaults to the resolver model. Set it to a
# different model to avoid self-preference bias (a judge grading its own model's output).
JUDGE_MODEL=
