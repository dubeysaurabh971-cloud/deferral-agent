LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
RESOLVER_MODEL=claude-sonnet-5

# Only used when LLM_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=grok-4-fast

# Only used when LLM_PROVIDER=gemini (Google AI Studio key, via the OpenAI-compat endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Only used when LLM_PROVIDER=openai. Note: gpt-5* / o* models require
# max_completion_tokens instead of max_tokens -- config.MAX_TOKENS_FIELD handles that.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional: model for the LLM-judge scorers. Defaults to the resolver model. Set it to a
# different model to avoid self-preference bias (a judge grading its own model's output).
JUDGE_MODEL=

# gpt-5*/o* only: hidden reasoning tokens share the completion budget and bill at the
# output rate. "low" leaves room for the JSON and keeps the bill down. Empty = omit the param
# (required for gpt-4.1*/gpt-4o*, which reject it).
OPENAI_REASONING_EFFORT=low
